{
  "name": "voxpix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pxl-core": {
      "types": "./vendor/pxl-core.types.d.ts",
      "default": "./vendor/pxl/src/core/index.ts"
    }
  },
  "description": "Voxel models to pixel art in the browser: editor, CPU/GPU renderer and a 2.5D voxel-world engine.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "voxpix": "tsx --tsconfig tsconfig.runtime.json src/cli/main.ts",
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "icons": "node vendor/pxl/bin/pxl.js build app/icons/icons.px.js --no-preview && cp app/icons/out/icons.png app/icons/out/icons.json app/icons/out/sprites/btn*.png app/src/assets/ui/"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "4.1.12",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyeswong/voxpix.git"
  }
}
